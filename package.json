{
  "name": "driftlog-web",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "core/packages/*",
      "core/apps/*"
    ],
    "catalog": {
      "zod": "^4.6.5",
      "elysia": "^1.4.30",
      "@elysiajs/eden": "^1.4.9",
      "drizzle-orm": "^0.45.3",
      "@types/bun": "latest",
      "@typescript/native-preview": "7.0.0-dev.20260707.2",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "@types/react": "^19.2.18",
      "@types/react-dom": "^19.2.7",
      "vite": "^8.3.1",
      "@vitejs/plugin-react": "^6.1.1",
      "tailwindcss": "^4.3.3",
      "@tailwindcss/vite": "^4.3.3",
      "@tanstack/react-router": "^1.170.39",
      "@tanstack/react-query": "^5.104.0",
      "@tanstack/react-form": "^1.33.5",
      "radix-ui": "^1.6.7",
      "lucide-react": "^1.48.0",
      "class-variance-authority": "^0.7.1",
      "sonner": "^2.0.8",
      "tw-animate-css": "^1.4.0"
    }
  },
  "scripts": {
    "dev": "bun --filter './apps/*' dev",
    "dev:blog": "bun --filter @driftlog/blog dev",
    "dev:admin": "bun --filter @driftlog/admin dev",
    "build": "bun --filter './apps/*' build",
    "typecheck": "bun --filter './apps/*' typecheck",
    "lint": "oxlint apps",
    "fmt": "oxfmt apps",
    "test": "playwright test"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@typescript/native-preview": "catalog:",
    "@playwright/test": "^1.63.0",
    "oxlint": "^1.85.0",
    "oxfmt": "^0.70.0"
  },
  "license": "AGPL-3.0-only"
}
